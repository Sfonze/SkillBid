# Copy this file to .env and fill in real values before running locally.

# Connection string for your Postgres database.
# For a hosted free-tier database (e.g. Neon), this is provided on your project's dashboard
# and looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/skillbid"

# Used to sign login session cookies. Generate a long random string for real use,
# e.g. by running: openssl rand -base64 32
# NEVER reuse this example value for a real deployment.
JWT_SECRET="dev-only-secret-change-me-in-production-aaaaaaaaaaaaaaaaaaaaaaaaaa"
